<Window x:Class="JustHangingAround.Client.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustHangingAround"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3F4F6">

    <Window.Resources>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="16"
                Padding="12"
                Margin="0,0,14,0">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Диалоги"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="4,0,0,12"/>

                <ListBox x:Name="UsersList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="UsersList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Правая панель -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="16"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="WelcomeText"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"/>

                        <TextBlock Text="Выберите пользователя слева и начните переписку"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Выйти"
                            Width="86"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Logout_Click"/>
                </Grid>

                <!-- Сообщения -->
                <ListBox x:Name="MessagesList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="#F9FAFB"
                         Padding="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="MessageBorder"
                                    Padding="12"
                                    Margin="0,0,0,10"
                                    CornerRadius="14"
                                    MaxWidth="420"
                                    Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">

                                <StackPanel>

                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               Margin="0,0,0,5"/>

                                    <TextBlock Text="{Binding Text}"
                                               FontSize="14"
                                               Foreground="#111827"
                                               TextWrapping="Wrap"/>

                                    <!-- Картинка -->
                                    <Border Margin="0,8,0,0"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Image Source="{Binding AttachmentUrl}"
                                               MaxHeight="230"
                                               Cursor="Hand"
                                               MouseLeftButtonUp="AttachmentImage_Click">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Border>

                                    <!-- Файл -->
                                    <Button Margin="0,8,0,0"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            Background="#EEF2FF"
                                            Foreground="#1D4ED8"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="AttachmentFile_Click">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📎" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding AttachmentFileName}"/>
                                        </StackPanel>

                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasAttachment}" Value="True"/>
                                                            <Condition Binding="{Binding IsImage}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                    <Setter TargetName="MessageBorder" Property="Background" Value="#DBEAFE"/>
                                    <Setter TargetName="MessageBorder" Property="BorderBrush" Value="#BFDBFE"/>
                                    <Setter TargetName="MessageBorder" Property="HorizontalAlignment" Value="Right"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Низ -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="MessageInput"
                             Grid.Row="0"
                             Height="42"
                             Padding="12,8"
                             FontSize="14"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1"
                             KeyDown="MessageInput_KeyDown"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">

                        <Button x:Name="SendFileButton"
                                Content="Файл"
                                Width="96"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SendFile_Click"/>

                        <Button Content="Скрин"
                                Width="96"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SendScreenshot_Click"/>

                        <Button Content="Отправить"
                                Width="130"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Send_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>