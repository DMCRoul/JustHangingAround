<Window x:Class="JustHangingAround.Client.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustHangingAround"
        Height="420"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WelcomeText"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <ListBox x:Name="MessagesList"
                 Grid.Row="1"
                 Margin="0,0,0,15"/>

        <TextBox x:Name="MessageInput"
                 Grid.Row="2"
                 Height="32"
                 Margin="0,0,0,10"/>

        <Button Grid.Row="3"
                Content="Отправить"
                Height="36"
                Click="Send_Click"/>
    </Grid>
</Window>