<Window x:Class="JustHangingAround.Client.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustHangingAround"
        Height="420"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список пользователей -->
        <ListBox x:Name="UsersList"
                 Grid.Column="0"
                 Margin="0,0,15,0"
                 SelectionChanged="UsersList_SelectionChanged"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верх -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">

                <TextBlock x:Name="WelcomeText"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="Выйти"
                        Click="Logout_Click"
                        Width="80"
                        Margin="20,0,0,0"/>
            </StackPanel>

            <!-- Сообщения -->
            <ListBox x:Name="MessagesList"
                     Grid.Row="1"
                     Margin="0,0,0,10"
                     BorderThickness="0"
                     Background="Transparent">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="MessageBorder"
                                Padding="10"
                                Margin="0,0,0,8"
                                CornerRadius="10"
                                MaxWidth="300"
                                Background="#EFEFEF"
                                HorizontalAlignment="Left">

                            <StackPanel>

                                <!-- Username -->
                                <TextBlock Text="{Binding Username}"
                                           FontWeight="Bold"
                                           Margin="0,0,0,4"/>

                                <!-- Text -->
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"/>

                                <!-- Картинка -->
                                <Image Source="{Binding AttachmentUrl}"
                                       MaxHeight="200"
                                       Margin="0,5,0,0"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="AttachmentImage_Click">

                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Файл -->
                                <Button Content="{Binding AttachmentFileName}"
                                        Margin="0,6,0,0"
                                        Padding="8,4"
                                        HorizontalAlignment="Left"
                                        Cursor="Hand"
                                        Click="AttachmentFile_Click">

                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>

                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasAttachment}" Value="True"/>
                                                        <Condition Binding="{Binding IsImage}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>

                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </StackPanel>
                        </Border>

                        <!-- Свои сообщения справа -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                <Setter TargetName="MessageBorder" Property="Background" Value="#DCF8C6"/>
                                <Setter TargetName="MessageBorder" Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Ввод -->
            <TextBox x:Name="MessageInput"
                     Grid.Row="2"
                     Height="32"
                     Margin="0,0,0,10"
                     KeyDown="MessageInput_KeyDown"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="3" Orientation="Horizontal">

                <Button x:Name="SendFileButton"
                        Content="Файл"
                        Height="36"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="SendFile_Click"/>

                <Button Content="Отправить"
                        Height="36"
                        Width="120"
                        Click="Send_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>